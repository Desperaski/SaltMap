<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Путь к игре (если пусто, будет искать в стандартном Steam) -->
    <GameDir Condition="'$(GameDir)' == ''">G:\SteamLibrary\steamapps\common\Salt and Sanctuary</GameDir>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SaltMap</AssemblyName>
    <RootNamespace>SaltMap</RootNamespace>
    <Version>0.5.0</Version>

    <!-- Настройки версии для ZIP-архива -->
    <ZipFileVersion>$(Version)</ZipFileVersion>
    <ZipOutputPath>$(MSBuildProjectDirectory)/../dist/</ZipOutputPath>
    
    <!-- salt.exe — это 32-битная сборка -->
    <PlatformTarget>x86</PlatformTarget>
    
    <!-- Отключаем PDB для релиза -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    
    <!-- Если игра установлена, компилируется с ней и устанавливается в неё после каждой сборки. 
         Если нет (например, GitHub Actions), компилируется с заглушками в Reference\salt 
         и NuGet-пакетом MonoGame, и ничего не устанавливает. -->
    <UseGame Condition="'$(UseGame)' == '' and Exists('$(GameDir)\salt.exe')">true</UseGame>
    <UseGame Condition="'$(UseGame)' == ''">false</UseGame>
  </PropertyGroup>

  <ItemGroup>
    <!-- Иконка карты в меню, нарисованная для этого мода (не является ресурсом игры). -->
    <EmbeddedResource Include="Resources\mapicon.png" LogicalName="SaltMap.mapicon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Файлы локализации -->
    <Content Include="lang\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Компоненты .NET Framework: GDI+ декодирует тайлы карты, JSON-ридер парсит markers.js. -->
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
    <PackageReference Include="Lib.Harmony" Version="2.4.1" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseGame)' == 'true'">
    <!-- Компиляция с установленной игрой; ни один из файлов не копируется и не поставляется. -->
    <Reference Include="salt">
      <HintPath>$(GameDir)\salt.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoGame.Framework">
      <HintPath>$(GameDir)\MonoGame.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseGame)' != 'true'">
    <!-- Заглушки для сборки без установленной игры -->
    <ProjectReference Include="..\Reference\salt\salt.csproj" Private="false" />
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.7.1.189" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Подключаем проект патчера, чтобы он собирался первым -->
  <ItemGroup>
    <ProjectReference Include="..\Patcher\SaltPatcher.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Импорт кастомных целей сборки -->
  <Import Project="tasks.targets" />

</Project>